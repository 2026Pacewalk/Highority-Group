{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "highority-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "highority-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/index.js"],
      "cwd": "server",
      "port": 4500,
      "autoPort": true
    }
  ]
}
